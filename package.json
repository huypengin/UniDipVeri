{
  "name": "unidipveri-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:issuer": "bun --filter @unidipveri/issuer dev",
    "dev:playground": "bun --filter @unidipveri/playground dev",
    "typecheck": "bun --filter \"*\" typecheck",
    "test": "bun --filter \"*\" test",
    "test:interop": "bun run scripts/issuer-verifier.interop.test.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.2"
  }
}
