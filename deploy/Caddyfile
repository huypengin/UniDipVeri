{
    admin off
}

:{$PORT:10000} {
    # Root redirect to Playground showcase
    redir / /playground/ 302

    # Trailing slash normalizations
    redir /issuer /issuer/ 308
    redir /playground /playground/ 308
    redir /verifier /verifier/ 308

    # RFC 8414 & OID4VCI discovery (supports root and /issuer path insertion)
    handle /.well-known/openid-credential-issuer* {
        rewrite * /.well-known/openid-credential-issuer
        reverse_proxy 127.0.0.1:3000
    }

    handle /.well-known/oauth-authorization-server* {
        rewrite * /.well-known/oauth-authorization-server
        reverse_proxy 127.0.0.1:3000
    }

    handle /.well-known/openid-configuration* {
        rewrite * /.well-known/openid-configuration
        reverse_proxy 127.0.0.1:3000
    }

    handle /.well-known/jwt-vc-issuer* {
        rewrite * /.well-known/jwt-vc-issuer
        reverse_proxy 127.0.0.1:3000
    }

    handle /.well-known/did.json* {
        rewrite * /.well-known/did.json
        reverse_proxy 127.0.0.1:3000
    }

    # W3C did:web with path (did:web:<domain>:issuer resolves to /issuer/did.json)
    handle /issuer/did.json {
        rewrite * /.well-known/did.json
        reverse_proxy 127.0.0.1:3000
    }

    # Scoped application routes
    handle_path /playground/* {
        reverse_proxy 127.0.0.1:3001
    }

    handle_path /issuer/* {
        reverse_proxy 127.0.0.1:3000
    }

    handle_path /verifier/* {
        reverse_proxy 127.0.0.1:7004
    }

    # Walt.id verification session callback & status queries
    handle /verification-session/* {
        reverse_proxy 127.0.0.1:7004
    }

    # Playground UI client AJAX endpoints
    handle /api/* {
        reverse_proxy 127.0.0.1:3001
    }

    # Direct health check endpoint
    handle /health {
        respond "OK" 200
    }
}
